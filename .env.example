# =============================================================================
#  Podcast Aggregation & API Platform — environment template
#  Copy to bin/dev/.env (dev) or bin/prod/.env (prod) and fill in.
# =============================================================================

# --- PostgreSQL (required in production) ----------------------------------
POSTGRES_DB=core_db
POSTGRES_USER=core_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis (cache + Celery broker) --------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
CELERY_BROKER_URL=redis://:change-me@redis:6379/0
CELERY_RESULT_BACKEND=django-db

# --- Django ----------------------------------------------------------
DEBUG=False
DJANGO_SECRET_KEY=generate-a-50-char-random-string
LOG_LEVEL=INFO

# --- Enrichment providers (TT §2.2) ---------------------------------
# Apple Podcasts / iTunes: no key required, always enabled.
# PodcastIndex — free key: https://api.podcastindex.org
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Podchaser — free key: https://www.podchaser.com/profile/settings/api
#   * needed to use Podchaser as a CHART source (its /charts page is JS-rendered)
#   * also used for ratings during enrichment
PODCHASER_API_KEY=
PODCHASER_API_SECRET=
ENRICHMENT_PROVIDER_ORDER=apple,podcastindex,podchaser

# --- Scraping scope (TT §2.1) -------------------------------------
SPOTIFY_CHART_REGIONS=us,gb,de,fr,es,it,br,au,ca,in,mx,se,ie,nl,jp
SPOTIFY_CHART_CATEGORIES=top-podcasts,top-episodes,comedy,news,true-crime,business,society-culture,sports,education,technology
SPOTIFY_EPISODE_CATEGORIES=top-episodes
PODCHASER_CHART_COUNTRIES=us,gb,de,ca,au
PODCHASER_CHART_CATEGORIES=all,comedy,news,true-crime,business,society-culture,technology,sports

# --- Scraper HTTP behaviour --------------------------------------
SCRAPER_USER_AGENT=PodcastAggregatorBot/1.0 (+https://example.com/bot; contact=ops@example.com)
SCRAPER_RESPECT_ROBOTS=True
SCRAPER_TIMEOUT=20
SCRAPER_MAX_RETRIES=4
SCRAPER_RATE_LIMIT_PER_HOST=3

# --- Ingestion tuning -----------------------------------------
EPISODE_REFRESH_MIN_INTERVAL_HOURS=12
ENRICHMENT_TTL_DAYS=30
ENRICH_BATCH_SIZE=200
EPISODE_SYNC_BATCH_SIZE=300

# --- Chart / API behaviour --------------------------------------
CHART_DEFAULT_COUNTRY=us
CHART_DEFAULT_CATEGORY=top-podcasts
CHART_RESPONSE_CACHE_TTL=600
CHART_LATEST_DATE_CACHE_TTL=300
CHART_PARTITION_START=2024-01-01
CHART_PARTITION_AHEAD_MONTHS=3
THROTTLE_ANON=120/min
THROTTLE_USER=600/min

# --- Email (inherited from the base project) ------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
